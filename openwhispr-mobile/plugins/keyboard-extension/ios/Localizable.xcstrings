    "autocorrection.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. Corrects only a few manually typed German letter swaps on space. Never changes dictation. Backspace immediately after a correction restores the original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Korrigiert beim Leerzeichen nur wenige selbst getippte deutsche Buchstabendreher. Ändert keine Diktate. Direktes Löschen nach einer Korrektur stellt das Original wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivada por defecto. Solo corrige algunas letras intercambiadas al escribir en alemán y pulsar espacio. No cambia dictados. Borrar justo después restaura el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivée par défaut. Corrige seulement quelques inversions de lettres saisies en allemand lors d’un espace. Ne modifie pas les dictées. Effacer juste après rétablit l’original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivata per impostazione predefinita. Corregge solo alcuni scambi di lettere digitati in tedesco quando premi spazio. Non modifica i dettati. Cancella subito dopo per ripristinare l’originale."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativada por padrão. Corrige apenas algumas trocas de letras digitadas em alemão ao inserir espaço. Não altera ditados. Apagar logo após restaura o original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключена. Исправляет лишь некоторые перестановки букв при ручном вводе на немецком после пробела. Не меняет диктовку. Удаление сразу после исправления возвращает оригинал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。仅在手动输入空格时更正少量德语字母颠倒。不修改听写。更正后立即按退格键可恢复原文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設關閉。僅在手動輸入空格時更正少量德語字母顛倒。不修改聽寫。更正後立即按退格鍵可還原原文。"
          }
        }
      }
    },
